{
  "name": "tiktok-magic-maker-55",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/pix_teste.php",
      "/pix.php",
      "/verifica_pagamento.php",
      "/pedido_detalhe.php",
      "/webhooks/legacy"
    ]
  }
}
